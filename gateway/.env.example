# Arkad MCP Gateway — environment
# These are Cloudflare Worker SECRETS (set with `wrangler secret put <NAME>`),
# never committed. For local dev, put values in `.dev.vars` (gitignored).
# ALLOWED_ORG is a plain var in wrangler.toml, not a secret.

# OAuth (GitHub OAuth App owned by your org; callback URL https://<worker>/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# CRM (crm_* tools) — the key stays on the gateway, clients never see it
CRM_API_URL=
CRM_API_KEY=
